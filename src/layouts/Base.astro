---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "iOS 앱을 개발부터 심사·출시·운영까지 맡아 온 모바일 엔지니어 김민준" } = Astro.props;

const menu = [
  { href: "/#work", label: "작업" },
  { href: "/about/", label: "소개" },
  { href: "/writing/", label: "글" },
  { href: "/#contact", label: "연락" },
];
const here = Astro.url.pathname.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- shortcut: noindex until the custom domain is set; remove it at launch. -->
    <meta name="robots" content="noindex" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #f7f5f0;
        --surface: #ffffff;
        --text: #1c1b19;
        --muted: #5f5c55;
        --line: #e2ded4;
        --accent: #1f6f4a;
        --me: #1f6f4a;
        --agent: #6a4fb3;
        --peer: #9a5b13;
        --radius: 10px;
        --max: 46rem;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #141412;
          --surface: #1c1c19;
          --text: #ecebe6;
          --muted: #a7a49b;
          --line: #2f2e2a;
          --accent: #6cc79a;
          --me: #6cc79a;
          --agent: #b6a2ef;
          --peer: #e0a75e;
        }
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Pretendard", "Noto Sans KR", system-ui, sans-serif;
        font-size: 17px;
        line-height: 1.7;
        word-break: keep-all;
        overflow-wrap: anywhere;
      }
      a { color: var(--accent); text-underline-offset: 3px; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
      .wrap { max-width: var(--max); margin: 0 auto; padding: 0 16px; }
      .site-nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; align-items: baseline; padding-top: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); font-size: 0.95rem; }
      .site-nav .home { font-weight: 600; color: var(--text); text-decoration: none; margin-right: auto; }
      .site-nav [aria-current="page"] { color: var(--text); }
      .site-footer { color: var(--muted); font-size: 0.85rem; padding-top: 2rem; padding-bottom: 3rem; border-top: 1px solid var(--line); margin-top: 3rem; }
      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
      }
    </style>
  </head>
  <body>
    <nav class="wrap site-nav" aria-label="사이트">
      <a class="home" href="/" aria-current={here === "/" ? "page" : undefined}>김민준</a>
      {menu.map((m) => (
        <a href={m.href} aria-current={m.href === here ? "page" : undefined}>{m.label}</a>
      ))}
    </nav>
    <slot />
    <footer class="wrap site-footer">
      <p>Astro로 만들고 Cloudflare에 배포했습니다. 코드는 <a href="https://github.com/minjunkim-labs/portfolio">GitHub</a>에 있습니다.</p>
    </footer>
  </body>
</html>
