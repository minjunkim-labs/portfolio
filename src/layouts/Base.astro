---
import PostHog from "../components/PostHog.astro";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "iOS 앱을 개발부터 심사·출시·운영까지 맡아 온 모바일 엔지니어 김민준" } = Astro.props;

const menu = [
  { href: "/#work", label: "작업" },
  { href: "/about/", label: "소개" },
  { href: "/writing/", label: "글" },
  { href: "/#contact", label: "연락" },
];
const here = Astro.url.pathname.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- shortcut: noindex until the custom domain is set; remove it at launch. -->
    <meta name="robots" content="noindex" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <style is:global>
      /* Ledger look: cool white page, ink rules, system monospace labels. Colour is kept for one accent (the replay mark). */
      :root {
        --bg: #fbfcfc;
        --surface: #ffffff;
        --text: #12181c;
        --muted: #5a6770;
        --line: #d5dbdf;
        --accent: #0a7a4b;
        --radius: 4px;
        --max: 52rem;
        /* shortcut: system fonts only (CSP is default-src 'self'), self-host a webfont if the look must match across OSes. */
        --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #111517;
          --surface: #171c1f;
          --text: #e9edef;
          --muted: #9aa6ae;
          --line: #2a3136;
          --accent: #5fcf9b;
        }
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Pretendard", "Noto Sans KR", system-ui, sans-serif;
        font-size: 17px;
        line-height: 1.7;
        word-break: keep-all;
        overflow-wrap: anywhere;
      }
      a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
      a:hover { text-decoration-thickness: 2px; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--text); outline-offset: 3px; border-radius: 2px; }
      .label { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); letter-spacing: 0.01em; }
      /* Hangul falls back to the body font, so only the monospace space is too wide. */
      .label, .site-nav, .site-footer, .mono { word-spacing: -0.2em; }
      .wrap { max-width: var(--max); margin: 0 auto; padding: 0 16px; }
      .site-nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; align-items: baseline; padding-top: 1.25rem; padding-bottom: 0.9rem; font-family: var(--mono); font-size: 0.85rem; }
      .site-nav::after { content: ""; flex-basis: 100%; border-bottom: 2px solid var(--text); margin-top: 0.65rem; }
      .site-nav a { color: var(--muted); text-decoration: none; }
      .site-nav a:hover { color: var(--text); }
      .site-nav .home { font-family: inherit; font-weight: 600; color: var(--text); margin-right: auto; }
      .site-nav [aria-current="page"] { color: var(--text); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
      .site-footer { font-family: var(--mono); color: var(--muted); font-size: 0.78rem; padding-top: 1.5rem; padding-bottom: 3rem; border-top: 2px solid var(--text); margin-top: 4rem; }
      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
      }
    </style>
    <PostHog />
  </head>
  <body>
    <nav class="wrap site-nav" aria-label="사이트">
      <a class="home" href="/" aria-current={here === "/" ? "page" : undefined}>김민준</a>
      {menu.map((m) => (
        <a href={m.href} aria-current={m.href === here ? "page" : undefined}>{m.label}</a>
      ))}
    </nav>
    <slot />
    <footer class="wrap site-footer">
      <p>Astro로 만들고 Cloudflare에 배포했습니다. 코드는 <a href="https://github.com/minjunkim-labs/portfolio">GitHub</a>에 있습니다.</p>
    </footer>
  </body>
</html>
