---
import Base from "../layouts/Base.astro";

// Every fact below comes from the private career canon (canon/00_경력정본.md).
// Keep each claim's condition (period, "계산상", status) when editing.
type Work = {
  id: string;
  title: string;
  context: string;
  problem: string;
  turn: string;
  result: string;
  note?: string;
  link?: { href: string; label: string };
};

const works: Work[] = [
  {
    id: "ios-26-4",
    title: "iOS 26.4 업데이트 직후 멈춘 스플래시",
    context: "MyD · iOS · 2026",
    problem:
      "iOS 26.4가 나오자 앱이 스플래시에서 멈췄습니다. OS 업데이트 뒤에는 실기기로 앱을 점검하는 습관이 있었고, 그 점검에서 발견했습니다.",
    turn:
      "원인은 네트워크 상태를 확인하는 타이밍이었습니다. iOS 26.4에서는 첫 NWPathMonitor callback이 스플래시의 SwiftUI .task보다 늦게 와서, 연결 확인 전에 초기화를 건너뛰고 다시 실행하지 않았습니다.",
    result:
      "첫 callback 뒤에 다시 실행되도록 .task(id:)로 바꾸고, 긴급 심사로 제출 8시간 만에 패치를 배포했습니다. 뒤따른 회귀(iOS 18의 검정 화면, 로컬 서버 포트 충돌)는 3.3.18·3.3.19 버전에서 고쳤고, 네트워크 경우 6가지를 기준으로 확인했습니다.",
  },
  {
    id: "imageio",
    title: "공지 이미지 한 장이 앱을 종료시킬 때",
    context: "MyD · iOS · 2026",
    problem:
      "공지 팝업의 9432×17328px 이미지를 원본 크기로 디코딩하면 계산상 약 653MB가 되어, 앱이 강제 종료(SIGKILL)됐습니다. 테스트 중에 제가 발견했습니다. 원인은 AI 코딩 에이전트가 찾았습니다.",
    turn:
      "이미지를 화면에 맞게 줄여서 디코딩하면 됩니다. ImageIO 썸네일 다운샘플러로 긴 변을 화면 너비×배율 픽셀로 제한하고, 원본 캐시를 껐습니다.",
    result:
      "393pt·3배율 기기에서 계산상 642×1179, 약 3MB로 디코딩합니다. 정상·nil·손상 데이터 등 테스트 6개를 붙이고, 로딩 상태 갱신을 메인 액터로 고정했습니다.",
    note: "수정 뒤 메모리 사용량은 다시 재지 않았습니다. 위 숫자는 모두 계산값입니다.",
  },
  {
    id: "qr-session",
    title: "30초마다 바뀌는 QR, 끊기는 검증",
    context: "장병e음 모바일 신분증 · Android·iOS · 2025",
    problem: "QR이 30초마다 갱신될 때, 진행 중이던 검증이 끊겼습니다.",
    turn:
      "Android에서 이 문제를 발견해 원인을 찾았습니다. WebSocket 세션이 하나뿐인 구조였습니다.",
    result:
      "거래 ID별로 세션을 나누고(임시 ID를 실제 거래 ID로 교체), 단계별 timeout을 명시했습니다(QR 대기 45초, proof 30초, 검증 15초). 만료된 연결은 45초(QR 유효 30초 + 검증 15초)에 정리합니다. 같은 구조를 iOS에도 반영했고, iOS 구현에는 에이전트를 썼습니다.",
  },
  {
    id: "ios-sdk",
    title: "고객사 앱에 넣는 iOS SDK 배포 형태",
    context: "B2B 데이터 수집 SDK · iOS · 2026",
    problem:
      "고객사 앱에 넣을 iOS SDK를 어떤 형태로 배포할지 정해야 했습니다.",
    turn:
      "Swift SDK 앞에 Objective-C facade를 두고, Swift Package와 XCFramework(기기·시뮬레이터)로 배포하는 형태로 정했습니다. 결과물에는 checksum과 privacy manifest가 들어갑니다.",
    result:
      "구현은 에이전트 위주로 했습니다. 저는 sample host 3개가 같은 RC 결과물을 받아 동작하는지 검증했습니다. SDK는 Android 1.0.0과 iOS RC 단계에서 공급 계약 무산으로 고객사 전달 전 중단됐습니다.",
  },
  {
    id: "repo-office",
    title: "이슈 하나를, 리뷰까지 끝난 PR로",
    context: "repo-office · 개인 프로젝트 · 2026",
    problem:
      "에이전트에게 일을 맡기면 설계 승인, 리뷰, 병합의 경계가 흐려지기 쉽습니다.",
    turn:
      "엔진이 단계(설계 → 사람 승인 → 구현 → 검사 → PR → 리뷰)마다 Claude Code 작업자를 띄웠다가 닫습니다. 승인은 설계 문서의 sha256에 묶어, 승인 뒤 설계가 바뀌면 다시 승인을 받습니다. 리뷰는 구현과 다른 세션이 하고, 병합은 사람이 합니다. 설계와 기준은 제가 정했습니다. 코드는 에이전트가 썼습니다.",
    result:
      "실제 저장소 3곳에 연결해 2026년 11월 14~16일에 PR 23개를 열었고, 20개를 사람이 병합했습니다. 단위 테스트 84개가 통과합니다(1개 건너뜀, 2026-11-16).",
    note: "PR 품질, 재작업 비율, 과제당 시간은 아직 재지 않았습니다.",
    link: { href: "https://github.com/minjunkim-labs/repo-office", label: "저장소 보기" },
  },
];

---

<Base title="김민준 · iOS 엔지니어">
  <header class="hero wrap">
    <div class="intro">
      <p class="label">김민준 · iOS 엔지니어</p>
      <h1>iOS 앱을 개발부터 <span class="nb">심사·출시·운영까지</span> 맡아 온 모바일 엔지니어입니다.</h1>
      <p class="lead">OS가 업데이트되면 실제 기기에서 앱을 다시 점검합니다. iOS 26.4 업데이트 직후의 스플래시 정지도 이 점검에서 발견했습니다.</p>
    </div>
    <figure class="replay">
      <div class="phone">
        <div class="screen" id="replay-screen">
          <span class="label">iOS 26.4</span>
          <p class="state"><span class="mark" aria-hidden="true"></span><span id="replay-state" aria-live="polite">스플래시에서 멈춤</span></p>
          <button type="button" id="replay-toggle">수정 후 보기</button>
        </div>
      </div>
      <figcaption class="label">아래 첫 사례를 다시 그린 예시 화면</figcaption>
    </figure>
    <ul class="facts">
      <li><strong>4년 4개월</strong><span>개인 데이터 플랫폼 MyD를 비롯한 앱 개발·운영 (2022.06–2026.10)</span></li>
      <li><strong>87개 버전</strong><span>MyD iOS 앱 전체 출시 버전 수(2022.06 이후). 2025년 8월 이후 15개 버전은 모두 제가 출시</span></li>
      <li><strong>99.8%</strong><span>MyD iOS crash-free 세션 (2026년 7~9월, Crashlytics)</span></li>
    </ul>
  </header>

  <main>
    <section id="work" class="wrap" aria-labelledby="work-title">
      <h2 id="work-title">작업</h2>
      {works.map((w) => (
        <article class="work" id={w.id} aria-labelledby={`${w.id}-title`}>
          <ul class="context label" aria-label="맥락">
            {w.context.split(" · ").map((c) => <li>{c}</li>)}
          </ul>
          <div class="body">
          <h3 id={`${w.id}-title`}>{w.title}</h3>
          <dl>
            <dt class="mono">문제</dt>
            <dd>{w.problem}</dd>
            <dt class="mono">원인과 방향</dt>
            <dd>{w.turn}</dd>
            <dt class="mono">결과</dt>
            <dd>{w.result}</dd>
          </dl>
          {w.note && <p class="note">{w.note}</p>}
          {w.link && <p class="more"><a href={w.link.href}>{w.link.label} <span aria-hidden="true">→</span></a></p>}
          </div>
        </article>
      ))}
    </section>

    <section id="contact" class="wrap contact" aria-labelledby="contact-title">
      <h2 id="contact-title">연락</h2>
      <p>새 기회에 열려 있습니다. 서울·경기, 출근·하이브리드·원격 모두 가능합니다.</p>
      <p>
        <button type="button" id="email" data-user="minjunkim.dev" data-domain="gmail.com">이메일 주소 보기</button>
      </p>
      <ul class="links">
        <li><a href="https://github.com/minjunkim-dev">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/minjun-kim-bene-dev">LinkedIn</a></li>
        <li><a href="/writing/">글</a></li>
      </ul>
    </section>
  </main>
</Base>

<script>
  // Builds the address on click so the raw address is not in the HTML for scrapers.
  const button = document.getElementById("email");
  button?.addEventListener("click", () => {
    const address = `${button.dataset.user}@${button.dataset.domain}`;
    const link = document.createElement("a");
    link.href = `mailto:${address}`;
    link.textContent = address;
    button.replaceWith(link);
    link.focus();
  });

  // Replays the first case in two states; the text below it carries the same facts without script.
  const toggle = document.getElementById("replay-toggle");
  toggle?.addEventListener("click", () => {
    const fixed = document.getElementById("replay-screen")!.classList.toggle("fixed");
    document.getElementById("replay-state")!.textContent = fixed ? "첫 callback 뒤 초기화를 다시 실행" : "스플래시에서 멈춤";
    toggle.textContent = fixed ? "수정 전 보기" : "수정 후 보기";
  });
</script>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem 2.5rem; align-items: center; padding-top: 3.5rem; padding-bottom: 3.5rem; }
  h1 { font-size: clamp(1.7rem, 4.6vw, 2.5rem); line-height: 1.32; margin: 0.9rem 0 0; letter-spacing: -0.02em; text-wrap: balance; }
  .nb { white-space: nowrap; }
  .lead { font-size: 1.05rem; color: var(--muted); margin: 1.1rem 0 0; max-width: 34em; }
  .replay { margin: 0; display: grid; gap: 0.6rem; justify-items: center; text-align: center; }
  .phone { width: 9.5rem; aspect-ratio: 9 / 18; border-radius: 1.5rem; background: var(--text); padding: 0.4rem; }
  .screen { height: 100%; border-radius: 1.15rem; background: var(--surface); color: var(--text); display: grid; grid-template-rows: auto 1fr auto; padding: 0.8rem 0.55rem 0.55rem; }
  .state { margin: 0; display: grid; place-content: center; justify-items: center; gap: 0.55rem; font-size: 0.72rem; line-height: 1.45; color: var(--muted); }
  .mark { width: 2.4rem; height: 2.4rem; border: 2px solid var(--line); border-radius: 0.6rem; transition: border-color 0.2s, border-radius 0.2s; }
  .fixed .mark { border-color: var(--accent); border-radius: 50%; }
  #replay-toggle { font: inherit; font-size: 0.72rem; font-weight: 600; color: var(--bg); background: var(--text); border: 0; border-radius: 0.5rem; padding: 0.45rem; cursor: pointer; }
  .facts { grid-column: 1 / -1; list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); border-top: 1px solid var(--line); }
  .facts li { border-bottom: 1px solid var(--line); padding: 0.8rem 1rem 0.8rem 0; display: grid; gap: 0.15rem; align-content: start; }
  .facts strong { font-family: var(--mono); font-weight: 500; font-size: 1.35rem; font-variant-numeric: tabular-nums; word-spacing: -0.2em; }
  .facts span { color: var(--muted); font-size: 0.86rem; line-height: 1.5; }
  h2 { font-size: 1.4rem; margin: 0 0 0.4rem; }
  .work { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 1.5rem; padding: 1.5rem 0 2rem; border-top: 2px solid var(--text); }
  .context { list-style: none; margin: 0; padding: 0.3rem 0 0; display: grid; gap: 0.25rem; align-content: start; }
  h3 { font-size: 1.2rem; margin: 0 0 0.9rem; line-height: 1.4; }
  dl { margin: 0; }
  dt { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); margin-top: 0.9rem; }
  dd { margin: 0.15rem 0 0; }
  .note { color: var(--muted); font-size: 0.9rem; margin: 1rem 0 0; }
  .more { margin: 1rem 0 0; }
  .contact { padding-top: 1.5rem; border-top: 2px solid var(--text); }
  #email { font: inherit; color: var(--bg); background: var(--text); border: 0; border-radius: var(--radius); padding: 0.6rem 1.1rem; cursor: pointer; }
  .links { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 1.25rem; font-family: var(--mono); font-size: 0.85rem; }
  @media (max-width: 40rem) {
    .hero { grid-template-columns: 1fr; padding-top: 2.5rem; }
    .replay { order: 1; }
    .phone { width: 8rem; }
    .work { grid-template-columns: 1fr; gap: 0.5rem; }
    .context { grid-auto-flow: column; justify-content: start; gap: 0.5rem; }
    .context li + li::before { content: "· "; }
  }
</style>
