---
import Base from "../layouts/Base.astro";

// Titles, descriptions and dates are copied from the posts on the existing blog.
// shortcut: links go to the old blog, move the posts here when the custom domain is set.
const blog = "https://minjunkim-dev.github.io/writing";
const posts = [
  {
    slug: "web-deploy-verify-public-sha256",
    date: "2026-10-18",
    title: "HTTP 200은 배포 성공이 아니다: 공개 응답의 SHA-256으로 웹 배포 검증하기",
    description:
      "웹 프론트 3종의 운영 배포 성공 기준을 '업로드 완료'에서 '사용자가 받는 파일이 빌드한 파일과 같음'으로 바꾼 이유, 구현, 결과와 한계를 정리한다. HTTP 200만으로 부족한 이유도 다룬다.",
  },
  {
    slug: "ios-startup-idempotent-initialization",
    date: "2026-07-13",
    title: "iOS 초기화 중복 호출 줄이기: actor에서 실행 중인 Task 공유하기",
    description:
      "AppDelegate, Scene, 딥링크가 같은 초기화를 요청할 때 Task와 완료 결과를 공유하는 예제. 실패 후 재시도와 취소 정책도 정한다.",
  },
  {
    slug: "imageio-downsampling-memory-stability",
    date: "2026-07-09",
    title: "계산상 653MB가 되는 공지 이미지: ImageIO로 표시 크기만 디코딩하기",
    description:
      "9432×17328px 이미지를 원본 크기로 디코딩하면 계산상 약 653MB가 되던 문제를, ImageIO로 표시 크기만큼만 디코딩하도록 고친 기록. fit/fill 크기 계산, 캐시 키, 동시 디코딩 수와 메모리 확인 항목을 정리한다.",
  },
  {
    slug: "react-native-force-update-fail-open",
    date: "2026-07-04",
    title: "정책 서버가 죽어도 앱은 열려야 한다: 라이브 방송 앱의 fail-open 강제 업데이트",
    description:
      "운전 중 듣는 라이브 방송 앱에서 강제 업데이트를 설계한 기록. 정책 조회 실패와 업데이트 대상을 다른 상태로 나누고, 실패하면 진입을 허용한 이유와 결과를 정리한다.",
  },
];
---

<Base title="글 · 김민준" description="모바일 엔지니어 김민준이 쓴 기술 글 목록입니다.">
  <header class="wrap top">
    <p class="eyebrow">글</p>
    <h1>작업하며 쓴 기술 글입니다.</h1>
    <p class="lead">글은 기존 기술 블로그에 있습니다. 제목을 누르면 블로그로 이동합니다.</p>
  </header>

  <main class="wrap">
    <ol class="posts">
      {posts.map((p) => (
        <li>
          <time datetime={p.date}>{p.date}</time>
          <h2><a href={`${blog}/${p.slug}/`}>{p.title} <span aria-hidden="true">↗</span></a></h2>
          <p>{p.description}</p>
        </li>
      ))}
    </ol>
  </main>
</Base>

<style>
  .top { padding-top: 3rem; padding-bottom: 2rem; }
  .eyebrow { color: var(--muted); font-size: 0.95rem; margin: 0 0 1rem; }
  h1 { font-size: clamp(1.7rem, 4.5vw, 2.4rem); line-height: 1.3; margin: 0; letter-spacing: -0.02em; }
  .lead { font-size: 1.1rem; color: var(--muted); margin: 1.25rem 0 0; }
  .posts { list-style: none; margin: 0; padding: 0 0 4rem; }
  .posts li { padding: 1.5rem 0; border-top: 1px solid var(--line); }
  time { color: var(--muted); font-size: 0.9rem; }
  h2 { font-size: 1.15rem; line-height: 1.5; margin: 0.25rem 0; }
  .posts p { margin: 0; color: var(--muted); }
</style>
