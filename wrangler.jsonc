{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-11-16",
  // Static assets only: no Worker script, no bindings.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Required by `wrangler preview` (the PR preview command in Workers Builds). Empty: previews share the settings above.
  "previews": {}
}
